{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "custom-worker.mjs",
	"name": "seapals",
	"compatibility_date": "2026-04-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"SITE_URL": "https://seapalstcg.com",
		// During validation, checkout may originate on either exact app hostname.
		// SITE_URL remains canonical until the coordinated final cutover.
		"STORE_CHECKOUT_ALLOWED_ORIGINS": "https://seapalstcg.com,https://searealm.com",
		"SITE_LEGACY_ORIGINS": "https://seapalstcg.com,https://www.seapalstcg.com",
		"SITE_LEGACY_REDIRECT_ENABLED": "false",
		"SITE_LEGACY_REDIRECT_PERMANENT": "false",
		"STORE_CURRENCY": "usd",
		// Owner-approved public catalog: $44 Starter Kit, seven $22 decks, and the
		// $12 Accessories Kit. Individual accessories remain prepared but private.
		"STORE_AVAILABLE_PRODUCT_IDS": "starter-kit,blue-water,disruption,coral-garden,darkness-shroud,open-ocean-hunt,murky-water,stinging-fortress,accessory-set",
		"STORE_CATALOG_CONFIRMED": "true",
		"STORE_EXPEDITED_PRODUCTION_ENABLED": "true",
		"STORE_EXPEDITED_PRODUCTION_CENTS": "1000",
		"STORE_EXPEDITED_PRODUCTION_DAILY_ORDER_LIMIT": "10",
		"STORE_EXPEDITED_PRODUCTION_TIME_ZONE": "America/New_York",
		"STRIPE_PRODUCTION_TAX_CODE": "txcd_92010004",
		// Owner confirmed the hard 10-rush-order daily ceiling.
		"STORE_EXPEDITED_PRODUCTION_CAPACITY_CONFIRMED": "true",
		// Owner approved 2026-08-15 from ready-to-mail parcels through eight
		// pounds. Checkout still stays off until the separate catalog gate passes.
		"STORE_STANDARD_SHIPPING_CENTS": "1000",
		"STORE_PRIORITY_SHIPPING_CENTS": "1500",
		"STORE_LARGE_STANDARD_SHIPPING_CENTS": "2000",
		"STORE_LARGE_PRIORITY_SHIPPING_CENTS": "3500",
		"STORE_LOCAL_PICKUP_ENABLED": "true",
		"STORE_SHIPPING_RATES_CONFIRMED": "true",
		"STORE_ALLOWED_COUNTRIES": "US",
		"STORE_TAX_REGISTRATION_CONFIRMED": "true",
		"STORE_PICKUP_TAX_CONFIRMED": "true",
		"STRIPE_PICKUP_TAX_RATE_ID": "txr_1U4VO4E82MgJzjAxjYT88WGQ",
		"STRIPE_AUTOMATIC_TAX": "true",
		"STRIPE_GAME_PRODUCT_TAX_CODE": "txcd_99999999",
		"STRIPE_SHIPPING_TAX_CODE": "txcd_92010000",
		"STRIPE_ALLOW_PROMOTION_CODES": "false",
		"STRIPE_PAYMENT_METHOD_CONFIGURATION_ID": "pmc_1U47FJE82MgJzjAx30GeH09c",
		"STORE_SYNCHRONOUS_PAYMENT_METHODS_CONFIRMED": "true",
		"STORE_ORDER_NOTIFICATION_ENABLED": "true",
		"STORE_ORDER_NOTIFICATION_EMAIL": "maker@seapalstcg.com",
		// Verified 2026-08-15 with a received synthetic production-Worker alert.
		"STORE_ORDER_NOTIFICATION_DELIVERY_CONFIRMED": "true",
		// One reminder is queued at 9:00 a.m. Eastern on the business day before
		// each paid live order must be ready for shipment or pickup.
		"STORE_FULFILLMENT_DUE_NOTIFICATION_ENABLED": "true",
		// Q3 2026 closes September 30 and is due October 20. The same verified
		// private sender/recipient path used by purchase alerts is already tested.
		"STORE_PA_TAX_REPORT_ENABLED": "true",
		"STORE_PA_TAX_REPORT_EMAIL": "maker@seapalstcg.com",
		"STORE_PA_TAX_REPORT_START_PERIOD_END": "2026-09-30",
		"STORE_PA_TAX_REPORT_DELIVERY_CONFIRMED": "true",
		"EMAIL_FROM": "SeaPals <maker@seapalstcg.com>",
		"STORE_CHECKOUT_ENABLED": "true",
		"STORE_SHOW_FUTURE_PRODUCTS": "false",
		"STORE_COLLECT_PHONE": "false"
	},
	"ratelimits": [
		{
			"name": "STORE_CHECKOUT_RATE_LIMITER",
			// Stable account-unique namespace for checkout attempts only.
			"namespace_id": "2026081501",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "seapals"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
