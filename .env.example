# Public site URL (use http://localhost:3000 for local Stripe testing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a separate random value of at least 32 characters for pending
# adventure-account approval cookies. Falls back to the service-role key only
# for local/backward-compatible setup.
ADVENTURE_AUTH_SIGNING_SECRET=

# Stripe test-mode credentials. Never expose these with NEXT_PUBLIC_ names.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Checkout remains off unless this is explicitly true and the required
# Stripe/Supabase settings above are present.
STORE_CHECKOUT_ENABLED=false
STORE_ADMIN_TOKEN=
STORE_CURRENCY=usd

# Prices are integer cents. The pricing sheet establishes $40 Starter Kit,
# $20 expansion decks, and $10 Accessory Set in source. These are optional
# overrides; unpriced individual accessories/merch need a value before sale.
STORE_DEFAULT_PRICE_CENTS=
STORE_PRICE_STARTER_KIT_CENTS=
STORE_PRICE_BLUE_WATER_CENTS=
STORE_PRICE_DISRUPTION_CENTS=
STORE_PRICE_CORAL_GARDEN_CENTS=
STORE_PRICE_DARKNESS_SHROUD_CENTS=
STORE_PRICE_OPEN_OCEAN_HUNT_CENTS=
STORE_PRICE_MURKY_WATER_CENTS=
STORE_PRICE_STINGING_FORTRESS_CENTS=
STORE_PRICE_ACCESSORY_SET_CENTS=
STORE_PRICE_REEF_POINT_TOKENS_CENTS=
STORE_PRICE_DICE_PACK_CENTS=
STORE_PRICE_CONDITIONS_DECK_CENTS=
STORE_PRICE_CUSTOM_TSHIRT_CENTS=
STORE_PRICE_CARD_BINDER_CENTS=
STORE_PRICE_BACKPACK_CENTS=
STORE_PRICE_PLUSH_TOY_CENTS=

# No product is purchasable by default. Add only comma-separated product IDs
# whose price, variants, inventory, tax, and fulfillment have been verified.
STORE_AVAILABLE_PRODUCT_IDS=

# One flat shipping amount in cents. Zero displays as free shipping.
STORE_SHIPPING_CENTS=0
STORE_ALLOWED_COUNTRIES=US
STORE_SHIPPING_ESTIMATE_MIN_DAYS=
STORE_SHIPPING_ESTIMATE_MAX_DAYS=
STORE_COLLECT_PHONE=false

# Enable only after Stripe Tax is activated and tax registrations are reviewed.
STRIPE_AUTOMATIC_TAX=false
# A global fallback is supported, but category-specific codes are safer for a
# mixed catalog. Use only tax codes validated in the Stripe Tax catalog.
STRIPE_PRODUCT_TAX_CODE=
STRIPE_GAME_PRODUCT_TAX_CODE=
STRIPE_APPAREL_TAX_CODE=
STRIPE_STORAGE_TAX_CODE=
STRIPE_PLUSH_TAX_CODE=
STRIPE_ALLOW_PROMOTION_CODES=false

# Existing optional email integration used elsewhere in the app
RESEND_API_KEY=
EMAIL_FROM=

# Existing Kit newsletter form used for optional, consented account updates.
KIT_FORM_ID=9233650
