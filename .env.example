# Server-only canonical store origin. Use http://localhost:3000 locally and the
# final HTTPS origin in production.
SITE_URL=http://localhost:3000
# Legacy compatibility fallback. Prefer SITE_URL so the deployment origin is
# not compiled into browser JavaScript.
NEXT_PUBLIC_SITE_URL=

# Existing Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Separate random owner-only token of at least 32 characters for reviewing and approving bug reports.
BUG_REPORT_ADMIN_TOKEN=
# Generate a separate random value of at least 32 characters for pending
# adventure-account approval cookies. Falls back to the service-role key only
# for local/backward-compatible setup.
ADVENTURE_AUTH_SIGNING_SECRET=

# Stripe test-mode credentials. Never expose these with NEXT_PUBLIC_ names.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Checkout remains off unless this is explicitly true and the required
# Stripe/Supabase settings above are present.
STORE_CHECKOUT_ENABLED=false
STORE_ADMIN_TOKEN=
STORE_CURRENCY=usd

# Prices are positive integer cents. Draft source defaults are $44 for the
# Starter Kit, $22 per expansion deck, $12 for the Accessories Kit, and $5
# each for the Conditions Deck, Dice Pack, and Reef Point Token Set.
STORE_DEFAULT_PRICE_CENTS=
STORE_PRICE_STARTER_KIT_CENTS=
STORE_PRICE_BLUE_WATER_CENTS=
STORE_PRICE_DISRUPTION_CENTS=
STORE_PRICE_CORAL_GARDEN_CENTS=
STORE_PRICE_DARKNESS_SHROUD_CENTS=
STORE_PRICE_OPEN_OCEAN_HUNT_CENTS=
STORE_PRICE_MURKY_WATER_CENTS=
STORE_PRICE_STINGING_FORTRESS_CENTS=
STORE_PRICE_ACCESSORY_SET_CENTS=
STORE_PRICE_REEF_POINT_TOKENS_CENTS=
STORE_PRICE_DICE_PACK_CENTS=
STORE_PRICE_CONDITIONS_DECK_CENTS=
STORE_PRICE_CUSTOM_TSHIRT_CENTS=
STORE_PRICE_CARD_BINDER_CENTS=
STORE_PRICE_BACKPACK_CENTS=
STORE_PRICE_PLUSH_TOY_CENTS=

# No product is purchasable by default. Add only comma-separated product IDs
# whose price, variants, inventory, tax, and fulfillment have been verified.
STORE_AVAILABLE_PRODUCT_IDS=
# Independent live-mode gate. Keep false until every allowlisted SKU has either
# verified finished stock or owner-approved made-to-order ATP capacity, plus
# final packaged contents, product photos, price, and fulfillment.
STORE_CATALOG_CONFIRMED=false

# Every launch SKU uses standard made-to-order production: build and dispatch
# within 5 business days at no additional charge. The optional expedited choice
# is one $10 charge per order and promises dispatch within 1 business day; it
# does not promise one-day carrier delivery.
STORE_EXPEDITED_PRODUCTION_ENABLED=false
STORE_EXPEDITED_PRODUCTION_CENTS=1000
# Hard operational ceiling. Each expedited order consumes one slot on its
# Eastern-time production due date, regardless of item quantity.
STORE_EXPEDITED_PRODUCTION_DAILY_ORDER_LIMIT=10
STORE_EXPEDITED_PRODUCTION_TIME_ZONE=America/New_York
# Stripe's canonical Handling Charge code. Keep this exact value while the
# expedited production option is enabled.
STRIPE_PRODUCTION_TAX_CODE=txcd_92010004
# Owner gate: confirm shared labor can meet the one-business-day promise under
# the configured daily order limit. Keep false until that limit is approved.
STORE_EXPEDITED_PRODUCTION_CAPACITY_CONFIRMED=false

# Future apparel, storage, and plush concepts stay out of the default launch
# catalog. Turn this on only for a private catalog review.
STORE_SHOW_FUTURE_PRODUCTS=false

# Draft fixed rates for one whole order. Confirm them against packaged weights
# before live checkout. Scheduled Elverson pickup is free and arranged by email
# after production; keep its tax gate false until the fixed pickup rate below is
# verified.
STORE_STANDARD_SHIPPING_CENTS=750
STORE_PRIORITY_SHIPPING_CENTS=1250
STORE_LOCAL_PICKUP_ENABLED=false
STORE_SHIPPING_RATES_CONFIRMED=false
STORE_ALLOWED_COUNTRIES=US
# Legacy single-rate and estimate overrides retained for older deployments.
STORE_SHIPPING_CENTS=
STORE_SHIPPING_ESTIMATE_MIN_DAYS=
STORE_SHIPPING_ESTIMATE_MAX_DAYS=
STORE_COLLECT_PHONE=false

# Manual owner gate. Keep false until Pennsylvania confirms the government
# sales tax registration; recording a Stripe Tax registration is not confirmation.
STORE_TAX_REGISTRATION_CONFIRMED=false
# Keep false until the fixed Elverson pickup rate has been verified. Shipped
# orders use Stripe Automatic Tax; pickup uses this separately configured manual
# exclusive Tax Rate so a customer's billing address cannot change pickup tax.
STORE_PICKUP_TAX_CONFIRMED=false
STRIPE_PICKUP_TAX_RATE_ID=

# Shipped orders use Stripe Automatic Tax, so live checkout remains closed unless
# this is true. Pickup uses the separate fixed manual Tax Rate above. Enable both
# paths only after the Pennsylvania registration is Collecting and the product,
# shipping, origin, and pickup settings have been verified.
STRIPE_AUTOMATIC_TAX=false
# A global fallback is supported, but category-specific codes are safer for a
# mixed catalog. Use only tax codes validated in the Stripe Tax catalog.
STRIPE_PRODUCT_TAX_CODE=
STRIPE_GAME_PRODUCT_TAX_CODE=
STRIPE_SHIPPING_TAX_CODE=
STRIPE_APPAREL_TAX_CODE=
STRIPE_STORAGE_TAX_CODE=
STRIPE_PLUSH_TAX_CODE=
# Keep false until the order ledger reconciles Stripe's discount_cents and
# amount_discount values; otherwise staff totals can disagree with Stripe.
STRIPE_ALLOW_PROMOTION_CODES=false
# Dedicated Dashboard configuration that permits synchronous payment methods
# only. Inventory holds do not support delayed payment completion at launch.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
# Owner gate: confirm every enabled method in the dedicated configuration has
# a synchronous final payment result before enabling live inventory holds.
STORE_SYNCHRONOUS_PAYMENT_METHODS_CONFIRMED=false

# Purchase alerts are created only after a signed Stripe event records a paid
# order. Use a verified Resend sender and an explicit private recipient. The
# database lease and Resend's 24-hour idempotency window suppress routine
# duplicates. Delivery is at-least-once; see the runbook for the rare ambiguous
# response case after the provider window expires.
RESEND_API_KEY=
EMAIL_FROM=
STORE_ORDER_NOTIFICATION_ENABLED=false
STORE_ORDER_NOTIFICATION_EMAIL=
# Owner gate: set true only after a synthetic alert reaches the private inbox.
STORE_ORDER_NOTIFICATION_DELIVERY_CONFIRMED=false

# Existing Kit newsletter form used for optional, consented account updates.
KIT_FORM_ID=9233650
